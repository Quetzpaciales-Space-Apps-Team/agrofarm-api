# Copy to .env for local development. Never commit .env.
# These values only work with the local docker compose database.
DATABASE_URL=postgresql+psycopg://agrofarm:local-dev-only@localhost:5432/agrofarm
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://agrofarming.site"]
# Accepted alias for Terraform/Cloud Run deployments:
# CORS_ORIGINS=https://agrofarming.site
LOG_LEVEL=INFO
# Host port for the compose database. Change it if 5432 is taken.
DB_PORT=5432
# Host port for the compose API. Change it if 8080 is taken.
API_PORT=8080
# ML service integration and offline demo fallback
ML_MODE=fixture
ML_SERVICE_URL=http://localhost:8081
# none (local) or google_id_token (private ml-service on Cloud Run)
ML_AUTH=none
DEMO_MODE=false
# snapshot: demo mode never calls ml-service. live: with ML_MODE=http it calls ml-service and
# uses the cached answers only when the call fails.
DEMO_ML_SOURCE=snapshot

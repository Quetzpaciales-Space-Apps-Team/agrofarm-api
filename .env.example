# Copy to .env for local development. Never commit .env.
# These values only work with the local docker compose database.
DATABASE_URL=postgresql+psycopg://agrofarm:local-dev-only@localhost:5432/agrofarm
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# Host port for the compose database. Change it if 5432 is taken.
DB_PORT=5432
# Host port for the compose API. Change it if 8080 is taken.
API_PORT=8080
